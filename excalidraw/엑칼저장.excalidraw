    },
    {
      "id": "-LLY19LQGg58QAj0a_5XU",
      "type": "text",
      "x": -1524.1079634809046,
      "y": 3293.6559095142984,
      "width": 715.3397216796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
