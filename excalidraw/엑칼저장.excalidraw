    {
      "id": "ny53P-xU6xBo-8Syki_Ro",
      "type": "text",
      "x": -2302.3048328628697,
      "y": 2930.659064695034,
      "width": 511.55987548828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
