      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "──(HTTPS/WSS, 상용 5G)──────> 현장 출동대원 뷰어",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r-Py4V830F6yt1NgqIW1w",
      "type": "text",
      "x": -419.9199444002429,
      "y": 3617.8087563837785,
      "width": 379.7998352050781,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEi",
      "roundness": null,
      "seed": 487310403,
