      "seed": 996264099,
      "version": 78,
      "versionNonce": 160041398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786238097646,
      "link": null,
      "locked": false,
      "text": "- UNet이 2D 프레임에서 찾은 탐지 위치를 3D 장면 좌표로 변환 → 3D 마커가 됨",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- UNet이 2D 프레임에서 찾은 탐지 위치를 3D 장면 좌표로 변환 → 3D 마커가 됨",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5l5A0mboErYLzN-NF6vxe",
      "type": "text",
      "x": -1229.2980803632288,
      "y": 3328.6559095142984,
      "width": 125.71995544433594,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEL",
