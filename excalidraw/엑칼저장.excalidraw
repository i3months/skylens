    {
      "id": "7hFcHw8LsNyCU4tyrLzVV",
      "type": "text",
      "x": -1371.6899033708294,
      "y": 1007.7762199617339,
      "width": 206.39990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
